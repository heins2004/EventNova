<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Required for Android 11+ package visibility -->
    <queries>
        <package android:name="com.google.android.calendar" />
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EventNova">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".RoleSelectionActivity" />
        <activity android:name=".UserLoginActivity" />
        <activity android:name=".UserRegisterActivity" />
        <activity android:name=".UserDashboardActivity" />
        <activity android:name=".EventDetailActivity" />
        <activity android:name=".BookingBillActivity" />
        <activity android:name=".MyBookingsActivity" />
        <activity android:name=".UserProfileActivity" />
        <activity android:name=".OrgLoginActivity" />
        <activity android:name=".OrgRegisterActivity" />
        <activity android:name=".OrgDashboardActivity" />
        <activity android:name=".CreateEventActivity" />
        <activity android:name=".EditEventActivity" />
        <activity android:name=".OrgBookingsActivity" />
        <activity android:name=".OrgProfileActivity" />
        <activity android:name=".AdminLoginActivity" />
        <activity android:name=".AdminDashboardActivity" />

    </application>

</manifest>
