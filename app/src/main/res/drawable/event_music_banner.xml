<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="#EC407A"
                android:startColor="#6A1B9A" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:left="18dp" android:top="18dp">
        <shape android:shape="rectangle">
            <size android:width="46dp" android:height="92dp" />
            <solid android:color="#26FFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <item android:right="22dp" android:top="30dp">
        <shape android:shape="oval">
            <size android:width="58dp" android:height="58dp" />
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
