            <gradient
                android:angle="45"
                android:endColor="#5C6BC0"
                android:startColor="#00897B" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:left="18dp" android:top="26dp">
        <shape android:shape="oval">
            <size android:width="44dp" android:height="44dp" />
            <solid android:color="#35FFFFFF" />
        </shape>
    </item>
    <item android:right="14dp" android:bottom="14dp">
        <shape android:shape="rectangle">
            <size android:width="104dp" android:height="58dp" />
            <solid android:color="#24FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
